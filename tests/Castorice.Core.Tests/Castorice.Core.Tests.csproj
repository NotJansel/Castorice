<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Castorice.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      xUnit1051 asks for TestContext cancellation tokens. These tests drive a FakeTimeProvider and
      complete in microseconds, so there is nothing to cancel.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!--
      xunit.v3 4.x runs on Microsoft.Testing.Platform. The .NET 10 SDK no longer supports the old
      VSTest bridge, so "dotnet test" has to be pointed at the new runner explicitly.
    -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Castorice.Core/Castorice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped sample is parsed by a test, so a typo in it fails the build rather than a match. -->
    <None Include="../../samples/example-mappool.json" Link="samples/example-mappool.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
