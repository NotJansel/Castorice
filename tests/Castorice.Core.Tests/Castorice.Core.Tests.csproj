<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Castorice.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      xUnit1051 asks for TestContext cancellation tokens. These tests drive a FakeTimeProvider and
      complete in microseconds, so there is nothing to cancel.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Castorice.Core/Castorice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped sample is parsed by a test, so a typo in it fails the build rather than a match. -->
    <None Include="../../samples/example-mappool.json" Link="samples/example-mappool.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
