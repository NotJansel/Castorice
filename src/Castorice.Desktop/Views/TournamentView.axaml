<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Castorice.Desktop.ViewModels"
             xmlns:views="clr-namespace:Castorice.Desktop.Views"
             xmlns:svc="clr-namespace:Castorice.Desktop.Services"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="860"
             x:Class="Castorice.Desktop.Views.TournamentView"
             x:DataType="vm:TournamentViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ==================== Lobby bar ==================== -->
    <Border Grid.Row="0" Padding="20,14"
            Background="{DynamicResource CastoriceRailBrush}"
            BorderBrush="{DynamicResource CastoriceBorderBrush}"
            BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal" Classes="spaced">
        <ComboBox ItemsSource="{Binding PoolFiles}"
                  SelectedItem="{Binding SelectedPoolFile}"
                  MinWidth="210"
                  PlaceholderText="Mappool" />
        <TextBox Text="{Binding RedTeam}" PlaceholderText="Red team" Width="150" />
        <TextBox Text="{Binding BlueTeam}" PlaceholderText="Blue team" Width="150" />
        <Button Classes="accent" Content="Create lobby"
                Command="{Binding CreateRoomCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Border Width="1" Background="{DynamicResource CastoriceBorderBrush}" Margin="4,2,12,2" />
        <TextBox Text="{Binding AttachMatchId}" PlaceholderText="Match id or mp link" Width="190" />
        <Button Content="Attach" Command="{Binding AttachCommand}" />
        <Button Content="Detach" Command="{Binding DetachCommand}"
                IsEnabled="{Binding IsAttached}" />
        <Button Classes="danger" Content="Close lobby"
                Command="{Binding CloseRoomCommand}" IsEnabled="{Binding IsAttached}" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,400">

      <!-- ==================== Mappool ==================== -->
      <!--
        The scroll viewer alone does not stop a wide child from overflowing, so the content is
        clamped to the viewport width. Padding lives on this border so it counts against that width.
      -->
      <ScrollViewer Grid.Column="0" Name="PoolScroller" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="20,18" MaxWidth="{Binding #PoolScroller.Viewport.Width}">
        <StackPanel Spacing="18">

          <!-- Title and actions stack rather than share a row: a long pool name would
               otherwise push the buttons past the edge of the column. -->
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <!-- The heading is the rename affordance; it writes straight through to the pool. -->
              <TextBox Classes="titleEdit"
                       Text="{Binding PoolName}"
                       PlaceholderText="Mappool name"
                       ToolTip.Tip="Rename the pool. Save it to keep the change." />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <TextBlock Classes="muted" Text="{Binding PoolStage}" VerticalAlignment="Center" />
                <Border Classes="badge" IsVisible="{Binding HasPoolAcronym}">
                  <TextBlock Text="{Binding PoolAcronym}" />
                </Border>
              </StackPanel>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" Classes="tight">
              <Button Classes="ghost" Content="Fetch metadata" Command="{Binding FetchMetadataCommand}" />
              <Button Content="Save pool" Command="{Binding SavePoolCommand}" />
              <Button Classes="ghost" Content="New pool" Command="{Binding NewPoolCommand}" />
            </WrapPanel>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:SlotGroupViewModel">
                <StackPanel Margin="0,0,0,14" Spacing="8">
                  <TextBlock Classes="label" Text="{Binding Name}" />
                  <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Classes="spaced" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:MappoolSlotViewModel">
                        <Button Classes="pick"
                                Classes.current="{Binding IsCurrentPick}"
                                Classes.banned="{Binding IsBanned}"
                                Classes.picked="{Binding IsPicked}"
                                Command="{Binding $parent[UserControl].((vm:TournamentViewModel)DataContext).PickCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding DisplayName}">
                          <Button.ContextMenu>
                            <ContextMenu x:DataType="vm:MappoolSlotViewModel">
                              <MenuItem Header="Ban for Red" Command="{Binding BanRedCommand}" />
                              <MenuItem Header="Ban for Blue" Command="{Binding BanBlueCommand}" />
                              <Separator />
                              <MenuItem Header="Protect for Red" Command="{Binding ProtectRedCommand}" />
                              <MenuItem Header="Protect for Blue" Command="{Binding ProtectBlueCommand}" />
                              <Separator />
                              <MenuItem Header="Clear ban / protect" Command="{Binding ClearAvailabilityCommand}" />
                              <Separator />
                              <MenuItem Header="Picked by Red" Command="{Binding PickedByRedCommand}" />
                              <MenuItem Header="Picked by Blue" Command="{Binding PickedByBlueCommand}" />
                              <MenuItem Header="Clear pick" Command="{Binding ClearPickMarkCommand}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                          <Border CornerRadius="{StaticResource RadiusMedium}" ClipToBounds="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Panel>
                              <!-- Cover art, when the pool has been through a metadata fetch. -->
                              <Image Stretch="UniformToFill"
                                     svc:RemoteImageLoader.DecodeWidth="400"
                                     svc:RemoteImageLoader.Source="{Binding CoverUrl}" />
                              <Border Background="{StaticResource CastoriceCoverScrim}"
                                      IsVisible="{Binding HasCover}" />

                              <Grid RowDefinitions="Auto,*,Auto" Margin="11,9">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                  <TextBlock Grid.Column="0" Text="{Binding Label}"
                                             FontWeight="Bold" FontSize="14"
                                             Foreground="{DynamicResource CastoriceAccentBrush}" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                              Margin="8,0,0,0" HorizontalAlignment="Left">
                                    <Border Classes="badge"
                                            IsVisible="{Binding HasAvailabilityMark}"
                                            Background="{Binding AvailabilityTeam, Converter={x:Static views:ViewConverters.TeamToBrush}}">
                                      <TextBlock Text="{Binding AvailabilityLabel}" />
                                    </Border>
                                    <Border Classes="badge"
                                            IsVisible="{Binding IsPicked}"
                                            Background="{Binding PickedBy, Converter={x:Static views:ViewConverters.TeamToBrush}}">
                                      <TextBlock Text="{Binding PickLabel}" />
                                    </Border>
                                  </StackPanel>
                                  <Border Grid.Column="2" Classes="badge">
                                    <TextBlock Text="{Binding ModsBadge}" />
                                  </Border>
                                </Grid>

                                <StackPanel Grid.Row="2" Spacing="1">
                                  <TextBlock Text="{Binding DisplayName}"
                                             FontSize="12.5" FontWeight="SemiBold"
                                             TextTrimming="CharacterEllipsis"
                                             HorizontalAlignment="Left" />
                                  <!-- Collapsed until a metadata fetch fills them in. -->
                                  <TextBlock Classes="muted" Text="{Binding Subtitle}"
                                             TextTrimming="CharacterEllipsis"
                                             HorizontalAlignment="Left"
                                             IsVisible="{Binding Subtitle, Converter={x:Static views:ViewConverters.IsNotEmpty}}" />
                                  <TextBlock Classes="faint" Text="{Binding Metadata}"
                                             Margin="0,2,0,0"
                                             IsVisible="{Binding Metadata, Converter={x:Static views:ViewConverters.IsNotEmpty}}" />
                                </StackPanel>
                              </Grid>
                            </Panel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Pool editing -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Add a pick" />
              <WrapPanel Orientation="Horizontal" Classes="spaced">
                <TextBox Text="{Binding NewSlotLabel}" PlaceholderText="Label (NM1)" Width="130" />
                <TextBox Text="{Binding NewSlotBeatmapId}" PlaceholderText="Beatmap id or /b/ link" Width="220" />
                <TextBox Text="{Binding NewSlotMods}" PlaceholderText="Mods (HDHR)" Width="130" />
                <Button Classes="accent" Content="Add" Command="{Binding AddSlotCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="The beatmap id is the last number of an osu.ppy.sh/b/… link — the difficulty, not the set. Run Fetch metadata afterwards to pull in titles and cover art." />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Draft order" />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="Protects come first, then bans, then picks. Who opens each phase is set per match in the lobby panel. Saved with the pool." />
              <Grid ColumnDefinitions="110,*,110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding UseProtects}" VerticalAlignment="Center"
                          ToolTip.Tip="Leave off for a bracket without protects. A team can still pass on its protect during a match.">
                  <TextBlock Classes="label" Text="PROTECTS" />
                </CheckBox>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="4" Increment="1" FormatString="0"
                               Value="{Binding ProtectsPerTeam}" Margin="0,0,16,0"
                               IsEnabled="{Binding UseProtects}"
                               ToolTip.Tip="Per team. 0 is the same as turning protects off." />
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="ORDER" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"
                          IsEnabled="{Binding UseProtects}"
                          ItemsSource="{Binding TurnOrderChoices}" SelectedItem="{Binding ProtectOrderChoice}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="BANS" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="6" Increment="1" FormatString="0"
                               Value="{Binding BansPerTeam}" Margin="0,0,16,0"
                               ToolTip.Tip="Per team, before the first pick." />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="ORDER" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding TurnOrderChoices}" SelectedItem="{Binding BanOrderChoice}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="PICKS" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding PickOrderChoices}" SelectedItem="{Binding PickOrderChoice}" />
              </Grid>

              <TextBlock Classes="label" Text="SECOND BAN ROUND" Margin="0,4,0,0" />
              <Grid ColumnDefinitions="110,*,110,*">
                <TextBlock Grid.Column="0" Classes="label" Text="AFTER PICK" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="12" Increment="1" FormatString="0"
                               Value="{Binding SecondBanRoundAfterPicks}" Margin="0,0,16,0"
                               ToolTip.Tip="How many picks come before the second round. 0 means the bracket bans once." />
                <TextBlock Grid.Column="2" Classes="label" Text="BANS" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="3" Minimum="0" Maximum="4" Increment="1" FormatString="0"
                               Value="{Binding SecondRoundBansPerTeam}" IsEnabled="{Binding HasSecondBanRound}"
                               ToolTip.Tip="Per team, in the second round. Uses the same order as the first." />
              </Grid>
              <CheckBox Content="The other team opens the second round"
                        IsChecked="{Binding SecondRoundOtherTeamFirst}"
                        IsEnabled="{Binding HasSecondBanRound}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Room defaults" />
              <Grid ColumnDefinitions="110,*,110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="ACRONYM" VerticalAlignment="Center" />
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding PoolAcronym}" Margin="0,0,16,0" />
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="STAGE" VerticalAlignment="Center" />
                <TextBox  Grid.Row="0" Grid.Column="3" Text="{Binding PoolStage}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="TEAM MODE" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TeamModes}"
                          SelectedItem="{Binding Pool.TeamMode}" HorizontalAlignment="Stretch" Margin="0,0,16,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="WIN COND." VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding ScoreModes}"
                          SelectedItem="{Binding Pool.ScoreMode}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="START TIMER" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="300" Increment="5"
                               Value="{Binding Pool.StartTimerSeconds}" Margin="0,0,16,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" Text="READY TIMER" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="3600" Increment="15"
                               Value="{Binding Pool.ReadyTimerSeconds}" />
              </Grid>

              <CheckBox Content="Put the stage in the lobby name"
                        IsChecked="{Binding IncludeStageInRoomName}"
                        ToolTip.Tip="Off by default: brackets normally name a lobby &quot;TP: (Red) vs (Blue)&quot;." />
              <CheckBox Content="Add NoFail to every pick except FreeMod"
                        IsChecked="{Binding ForceNoFail}"
                        ToolTip.Tip="NM goes out as NF, HD as NF HD, DT as NF DT. On a FreeMod pick players choose their own mods." />

              <Separator />

              <TextBlock Classes="label" Text="FREEMOD RULE, PER TEAM" />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="Each team owes this many players in each group. Whoever is left over may play NoMod — which is why a 3v3 team has one NoMod slot spare and a 4v4 team two. A player counts towards the first group they match, so HDHR fills the HR slot." />
              <ItemsControl ItemsSource="{Binding FreeModGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:FreeModGroupViewModel">
                    <Grid ColumnDefinitions="90,*,Auto" Margin="0,0,0,6">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource CastoriceAccentBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding ModsDisplay}" Classes="muted"
                                 VerticalAlignment="Center" TextWrapping="Wrap" />
                      <NumericUpDown Grid.Column="2" Width="118" Minimum="0" Maximum="8" Increment="1"
                                     FormatString="0" Value="{Binding MinimumPerTeam}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="faint" TextWrapping="Wrap">
                <Run Text="Mods allowed at all:" />
                <Run Text="{Binding FreeModAllowedDisplay}" />
                <Run Text="— change the groups or that set in the pool file." />
              </TextBlock>
              <Separator />

              <TextBlock Classes="label" Text="FREEMOD SCORE MULTIPLIERS" />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="Set per FreeMod pick. Applied to players who took Easy, and named in the result posted to the lobby. A pick left on the pool default follows the two boxes at the bottom." />

              <TextBlock Classes="muted" Text="This pool has no FreeMod picks."
                         IsVisible="{Binding !HasFreeModSlots}" />

              <ItemsControl ItemsSource="{Binding FreeModSlots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:MappoolSlotViewModel">
                    <Border Classes="well" Margin="0,0,0,6">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Label}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource CastoriceAccentBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                     Classes="muted" Margin="10,0,10,0"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding MultiplierOriginLabel}"
                                     Classes="faint" VerticalAlignment="Center" />
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Classes="tight">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Classes="label" Text="EZ" VerticalAlignment="Center" />
                            <NumericUpDown Width="122" Minimum="1" Maximum="4" Increment="0.05"
                                           FormatString="0.00" Value="{Binding EasyMultiplier}" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Classes="label" Text="EZ+HD" VerticalAlignment="Center" />
                            <NumericUpDown Width="122" Minimum="1" Maximum="4" Increment="0.05"
                                           FormatString="0.00" Value="{Binding EasyHiddenMultiplier}" />
                          </StackPanel>
                          <Button Classes="ghost compact" Content="Use pool default"
                                  Command="{Binding UsePoolMultipliersCommand}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="label" Text="POOL DEFAULT" Margin="0,4,0,0" />
              <Grid ColumnDefinitions="110,*,110,*">
                <TextBlock Grid.Column="0" Classes="label" Text="EASY" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="4" Increment="0.05"
                               FormatString="0.00" Value="{Binding EasyMultiplier}" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Classes="label" Text="EASY + HD" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="3" Minimum="1" Maximum="4" Increment="0.05"
                               FormatString="0.00" Value="{Binding EasyHiddenMultiplier}" />
              </Grid>

              <Button Content="Push settings to lobby"
                      HorizontalAlignment="Left"
                      Command="{Binding ApplySettingsCommand}"
                      IsEnabled="{Binding IsAttached}" />
            </StackPanel>
          </Border>

        </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- ==================== Lobby panel ==================== -->
      <Border Grid.Column="1"
              Background="{DynamicResource CastoriceRailBrush}"
              BorderBrush="{DynamicResource CastoriceBorderBrush}"
              BorderThickness="1,0,0,0">
        <ScrollViewer Name="LobbyScroller" HorizontalScrollBarVisibility="Disabled">
          <Border Padding="18" MaxWidth="{Binding #LobbyScroller.Viewport.Width}">
          <StackPanel Spacing="16">

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="LOBBY" />
              <TextBlock Classes="h1" Text="{Binding RoomTitle}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding CurrentMapDisplay}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                          IsVisible="{Binding IsAttached}">
                <Border Classes="badge">
                  <TextBlock Text="{Binding CurrentModsDisplay}" />
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- Scoreboard -->
            <Grid ColumnDefinitions="*,Auto,*">
              <Border Grid.Column="0" CornerRadius="{StaticResource RadiusLarge}" Padding="14,12"
                      Background="{DynamicResource CastoriceRedTeamBrush}">
                <StackPanel>
                  <TextBlock Text="RED" Classes="label" Foreground="#FFFFFF" Opacity="0.85" />
                  <TextBlock Text="{Binding RedScore}" FontSize="32" FontWeight="Bold" Foreground="White" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="1" Text="vs" VerticalAlignment="Center" Margin="12,0" Classes="faint" />
              <Border Grid.Column="2" CornerRadius="{StaticResource RadiusLarge}" Padding="14,12"
                      Background="{DynamicResource CastoriceBlueTeamBrush}">
                <StackPanel>
                  <TextBlock Text="BLUE" Classes="label" Foreground="#FFFFFF" Opacity="0.85" />
                  <TextBlock Text="{Binding BlueScore}" FontSize="32" FontWeight="Bold" Foreground="White" />
                </StackPanel>
              </Border>
            </Grid>

            <WrapPanel Orientation="Horizontal" Classes="tight">
              <Button Classes="ghost compact" Content="+1 Red" Command="{Binding AddRedPointCommand}" />
              <Button Classes="ghost compact" Content="+1 Blue" Command="{Binding AddBluePointCommand}" />
              <Button Classes="ghost compact" Content="Reset" Command="{Binding ResetScoreCommand}" />
              <Button Classes="ghost compact" Content="Post score" Command="{Binding PostScoreCommand}"
                      ToolTip.Tip="Post the match score to the lobby now." />
            </WrapPanel>

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="label" Text="MATCH" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="faint" Text="{Binding MatchTargetDisplay}" />
              </Grid>

              <WrapPanel Orientation="Horizontal" Classes="tight">
                <ToggleButton Classes="compact" Content="Warmup" IsChecked="{Binding IsWarmup}"
                              ToolTip.Tip="While this is on, a finished map is never scored." />
                <ToggleButton Classes="compact" Content="Auto-score" IsChecked="{Binding AutoScore}"
                              ToolTip.Tip="Total the map when it ends, award the point and post the result to the lobby." />
                <ToggleButton Classes="compact" Content="FreeMod check" IsChecked="{Binding AutoFreeModCheck}"
                              ToolTip.Tip="When everyone is ready on a FreeMod pick, check the lobby against the pool's mod rule and warn if someone is off." />
              </WrapPanel>

              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Classes="label" Text="BEST OF" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="31" Increment="2"
                               Value="{Binding BestOf}" FormatString="0" />
              </Grid>

              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="Warmup is on until you turn it off, so a warmup map can never take a point by accident." />
            </StackPanel>

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="label" Text="DRAFT" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1" Orientation="Horizontal" Classes="tight">
                  <Button Classes="ghost compact" Content="Undo" Command="{Binding UndoDraftMarkCommand}"
                          ToolTip.Tip="Take back the newest protect, ban or pick." />
                  <Button Classes="ghost compact" Content="Clear" Command="{Binding ClearDraftCommand}" />
                  <Button Classes="ghost compact" Content="Post" Command="{Binding PostDraftCommand}"
                          ToolTip.Tip="Post every protect, ban and pick so far, and whose turn it is." />
                </WrapPanel>
              </Grid>

              <Border Classes="well">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding NextTurnTeam, Converter={x:Static views:ViewConverters.TeamToBrush}}" />
                    <TextBlock Text="{Binding NextTurnDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Text="{Binding DraftSummary}" Classes="muted" TextWrapping="Wrap" />
                  <Button Classes="ghost compact" HorizontalAlignment="Left"
                          Content="{Binding SkipTurnLabel}"
                          Command="{Binding SkipTurnCommand}"
                          IsVisible="{Binding CanSkipTurn}"
                          ToolTip.Tip="The team in turn passes on this protect or ban; the draft moves on." />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="FIRST PROTECT" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="FIRST BAN" />
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="FIRST PICK" />
                <ComboBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                          IsEnabled="{Binding UseProtects}"
                          ItemsSource="{Binding Teams}" SelectedItem="{Binding FirstProtect}" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Teams}" SelectedItem="{Binding FirstBan}" />
                <ComboBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Teams}" SelectedItem="{Binding FirstPick}" />
              </Grid>

              <StackPanel Spacing="4" IsVisible="{Binding HasBans}">
                <TextBlock Classes="label" Text="LATE SHOW" />
                <WrapPanel Orientation="Horizontal" Classes="tight">
                  <Button Classes="ghost compact" Content="{Binding ForfeitRedBansLabel}"
                          Command="{Binding ForfeitRedBansCommand}" IsEnabled="{Binding CanForfeitRedBans}"
                          ToolTip.Tip="Take away every ban this team has left, second round included. Undo gives them back." />
                  <Button Classes="ghost compact" Content="{Binding ForfeitBlueBansLabel}"
                          Command="{Binding ForfeitBlueBansCommand}" IsEnabled="{Binding CanForfeitBlueBans}"
                          ToolTip.Tip="Take away every ban this team has left, second round included. Undo gives them back." />
                </WrapPanel>
              </StackPanel>

              <CheckBox Content="Clicking a map marks the protect or ban that is due"
                        IsChecked="{Binding ClickFollowsDraft}"
                        ToolTip.Tip="While a protect or ban is due, a click marks the map for the team in turn instead of sending it to the lobby. Warmup picks always go to the lobby." />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="Picks outside warmup are credited to the team in turn. Right-click a map to set or correct any mark by hand." />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="POST TO THE LOBBY AUTOMATICALLY" />
              <CheckBox Content="Map result" IsChecked="{Binding Messages.MapResult}"
                        ToolTip.Tip="NM1 | Red 1,234,567 - 1,000,000 Blue | Red wins by 234,567" />
              <CheckBox Content="FreeMod multipliers" IsChecked="{Binding Messages.Multipliers}"
                        ToolTip.Tip="Multipliers: player EZ x1.75 (500,000 -> 875,000)" />
              <CheckBox Content="Match score after each map" IsChecked="{Binding Messages.MatchScore}"
                        ToolTip.Tip="Match score: Red 3 - 2 Blue (first to 7), or who won the match" />
              <CheckBox Content="Match score after +1" IsChecked="{Binding Messages.ScoreOnManualPoint}"
                        ToolTip.Tip="Also post the score when a point is awarded by hand." />
              <CheckBox Content="Protects, bans and picks" IsChecked="{Binding Messages.DraftActions}"
                        ToolTip.Tip="Red bans NM2 · Blue picks DT1: Artist - Title [Diff]" />
              <CheckBox Content="Whose turn is next" IsChecked="{Binding Messages.NextTurn}"
                        ToolTip.Tip="Next: Blue bans (2/4) — after each protect or ban and after each scored map." />
              <CheckBox Content="FreeMod check warnings" IsChecked="{Binding Messages.FreeModWarnings}"
                        ToolTip.Tip="The automatic check's warning when someone's mods break the rule. The Check FreeMod button always posts." />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="MATCH CONTROL" />
              <WrapPanel Orientation="Horizontal" Classes="tight" IsEnabled="{Binding IsAttached}">
                <Button Classes="accent" Content="Start" Command="{Binding StartCommand}" />
                <Button Content="Start now" Command="{Binding StartNowCommand}" />
                <Button Content="Abort timer" Command="{Binding AbortTimerCommand}" />
                <Button Classes="danger" Content="Abort match" Command="{Binding AbortCommand}" />
                <Button Content="Timer" Command="{Binding TimerCommand}" />
                <Button Content="Refresh settings" Command="{Binding RefreshRoomCommand}" />
                <Button Content="Lock" Command="{Binding LockCommand}" />
                <Button Content="Unlock" Command="{Binding UnlockCommand}" />
                <Button Content="Clear host" Command="{Binding ClearHostCommand}" />
                <Button Content="Invite refs" Command="{Binding InviteRefereesCommand}" />
                <Button Content="Check FreeMod" Command="{Binding CheckFreeModCommand}" />
              </WrapPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding IsAttached}">
              <TextBox Grid.Column="0" Text="{Binding InviteName}" PlaceholderText="Invite a player" />
              <Button Grid.Column="1" Content="Invite" Margin="6,0,0,0" Command="{Binding InviteCommand}" />
            </Grid>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="PLAYERS" />
              <TextBlock Classes="faint" Text="Nobody in the lobby yet."
                         IsVisible="{Binding !Players.Count}" />
              <ItemsControl ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:RoomPlayerViewModel">
                    <Border Background="{DynamicResource CastoriceSurfaceBrush}"
                            BorderBrush="{DynamicResource CastoriceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="10,8" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <Border Grid.Column="0" Grid.RowSpan="2" Width="3"
                                CornerRadius="{StaticResource RadiusPill}"
                                Margin="0,0,10,0"
                                Background="{Binding Team, Converter={x:Static views:ViewConverters.TeamToBrush}}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="12.5" />
                          <TextBlock Classes="faint">
                            <Run Text="Slot" /><Run Text=" " /><Run Text="{Binding Slot}" />
                            <Run Text=" · " /><Run Text="{Binding Status}" />
                            <Run Text=" · " /><Run Text="{Binding ScoreDisplay}" />
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="ghost compact" Content="Team" Margin="4,0,0,0"
                                ToolTip.Tip="Move to the other team"
                                Command="{Binding $parent[UserControl].((vm:TournamentViewModel)DataContext).SetTeamCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="3" Classes="danger compact" Content="Kick" Margin="4,0,0,0"
                                Command="{Binding $parent[UserControl].((vm:TournamentViewModel)DataContext).KickCommand}"
                                CommandParameter="{Binding}" />

                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                    Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                          <TextBlock Classes="label" Text="SLOT" VerticalAlignment="Center" />
                          <NumericUpDown Width="104" Minimum="1" Maximum="16" Increment="1"
                                         FormatString="0" Value="{Binding TargetSlot}" />
                          <Button Classes="ghost compact" Content="Move"
                                  ToolTip.Tip="Send this player to the slot on the left"
                                  Command="{Binding $parent[UserControl].((vm:TournamentViewModel)DataContext).MoveCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="LOBBY LOG" />
              <Border Classes="well" MinHeight="130">
                <ItemsControl ItemsSource="{Binding RoomLog}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                      <TextBlock Text="{Binding}" Classes="mono"
                                 Foreground="{DynamicResource CastoriceMutedTextBrush}"
                                 TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

          </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ==================== Status bar ==================== -->
    <Border Grid.Row="2" Padding="20,9"
            Background="{DynamicResource CastoriceRailBrush}"
            BorderBrush="{DynamicResource CastoriceBorderBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="9">
        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                 Fill="{DynamicResource CastoriceAccentBrush}" />
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
