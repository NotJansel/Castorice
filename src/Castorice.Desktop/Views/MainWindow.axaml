<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Castorice.Desktop.ViewModels"
        xmlns:views="clr-namespace:Castorice.Desktop.Views"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Castorice.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="980" MinHeight="620"
        Background="{DynamicResource CastoriceBackgroundBrush}">

  <Window.Resources>
    <DataTemplate x:Key="ChatTemplate" DataType="vm:ChatViewModel">
      <views:ChatView />
    </DataTemplate>
    <DataTemplate x:Key="TournamentTemplate" DataType="vm:TournamentViewModel">
      <views:TournamentView />
    </DataTemplate>
    <DataTemplate x:Key="ProfileTemplate" DataType="vm:ProfileViewModel">
      <views:ProfileView />
    </DataTemplate>
    <DataTemplate x:Key="SettingsTemplate" DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top bar: page switcher and connection control -->
    <Border Grid.Row="0"
            Background="{DynamicResource CastoriceSurfaceBrush}"
            BorderBrush="{DynamicResource CastoriceBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Castorice"
                     Classes="h2"
                     Foreground="{DynamicResource CastoriceAccentBrush}"
                     VerticalAlignment="Center"
                     Margin="4,0,16,0" />

          <Button Classes="nav" Classes.active="{Binding IsChatPage}" Content="Chat"
                  Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:AppPage.Chat}" />
          <Button Classes="nav" Classes.active="{Binding IsTournamentPage}" Content="Tournament"
                  Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:AppPage.Tournament}" />
          <Button Classes="nav" Classes.active="{Binding IsProfilePage}" Content="Profile"
                  Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:AppPage.Profile}" />
          <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Content="Settings"
                  Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:AppPage.Settings}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                   Fill="{DynamicResource CastoriceDangerBrush}"
                   IsVisible="{Binding !IsConnected}" />
          <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                   Fill="{DynamicResource CastoriceSuccessBrush}"
                   IsVisible="{Binding IsConnected}" />
          <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Classes="muted" />
          <Button Classes="accent" Content="Connect"
                  Command="{Binding ConnectCommand}"
                  IsVisible="{Binding !IsConnected}" />
          <Button Content="Disconnect"
                  Command="{Binding DisconnectCommand}"
                  IsVisible="{Binding IsConnected}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- All four pages stay loaded so chat backlog and scroll position survive a page switch. -->
    <Panel Grid.Row="1">
      <ContentControl Content="{Binding Chat}"
                      ContentTemplate="{StaticResource ChatTemplate}"
                      IsVisible="{Binding IsChatPage}" />
      <ContentControl Content="{Binding Tournament}"
                      ContentTemplate="{StaticResource TournamentTemplate}"
                      IsVisible="{Binding IsTournamentPage}" />
      <ContentControl Content="{Binding Profile}"
                      ContentTemplate="{StaticResource ProfileTemplate}"
                      IsVisible="{Binding IsProfilePage}" />
      <ContentControl Content="{Binding Settings}"
                      ContentTemplate="{StaticResource SettingsTemplate}"
                      IsVisible="{Binding IsSettingsPage}" />
    </Panel>

    <Border Grid.Row="2"
            Background="{DynamicResource CastoriceSurfaceBrush}"
            BorderBrush="{DynamicResource CastoriceBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6"
            IsVisible="{Binding ConnectionError, Converter={x:Static views:ViewConverters.IsNotEmpty}}">
      <TextBlock Text="{Binding ConnectionError}"
                 Foreground="{DynamicResource CastoriceDangerBrush}"
                 TextWrapping="Wrap" />
    </Border>

  </Grid>

</Window>
