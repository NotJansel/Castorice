<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Castorice.Desktop.ViewModels"
             xmlns:views="clr-namespace:Castorice.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="860"
             x:Class="Castorice.Desktop.Views.TournamentTabsView"
             x:DataType="vm:TournamentTabsViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- ==================== Tab strip ==================== -->
    <Border Grid.Row="0" Padding="12,6,12,0"
            Background="{DynamicResource CastoriceRailBrush}"
            BorderBrush="{DynamicResource CastoriceBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ListBox Classes="matchTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:TournamentViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding TabTip}">
                  <!-- Lit while the tab follows a lobby. -->
                  <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{DynamicResource CastoriceSuccessBrush}" IsVisible="{Binding IsAttached}" />
                  <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{DynamicResource CastoriceFaintTextBrush}" IsVisible="{Binding !IsAttached}" />
                  <TextBlock Grid.Column="1" Text="{Binding TabTitle}" MaxWidth="220"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                  <!-- Nothing to lose without a lobby, so that closes straight away. -->
                  <Button Grid.Column="2" Classes="ghost tabClose" Content="✕"
                          IsVisible="{Binding !IsAttached}"
                          ToolTip.Tip="Close this tab"
                          Command="{Binding $parent[UserControl].((vm:TournamentTabsViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="ghost tabClose" Content="✕"
                          IsVisible="{Binding IsAttached}"
                          ToolTip.Tip="Close this tab">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="10" MaxWidth="280">
                          <TextBlock Text="Close this tab?" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" TextWrapping="Wrap"
                                     Text="The lobby stays open on Bancho and can be attached again by its id, but this tab's draft and score are gone." />
                          <Button Classes="danger" Content="Close tab" HorizontalAlignment="Left"
                                  Command="{Binding $parent[UserControl].((vm:TournamentTabsViewModel)DataContext).CloseTabCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>

        <Button Grid.Column="1" Classes="ghost compact" Content="+ New match" Margin="8,0,0,6"
                VerticalAlignment="Center"
                ToolTip.Tip="Open another tab to referee a second lobby at the same time."
                Command="{Binding NewTabCommand}" />
      </Grid>
    </Border>

    <!-- ==================== Tabs ==================== -->
    <!-- Every tab's page stays built, so switching keeps its scroll positions and chat. -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Panel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:TournamentViewModel">
          <views:TournamentView IsVisible="{Binding IsSelected}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>

  <UserControl.Styles>
    <Style Selector="ListBox.matchTabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Browser-style tabs: rounded on top, the open one raised onto the page below. -->
    <Style Selector="ListBox.matchTabs ListBoxItem">
      <Setter Property="Padding" Value="12,6,6,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>

    <Style Selector="ListBox.matchTabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>

    <Style Selector="ListBox.matchTabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CastoriceSurfaceAltBrush}" />
    </Style>

    <Style Selector="ListBox.matchTabs ListBoxItem:not(:selected) TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CastoriceMutedTextBrush}" />
    </Style>

    <Style Selector="Button.tabClose">
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
