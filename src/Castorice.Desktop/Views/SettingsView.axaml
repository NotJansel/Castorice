<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Castorice.Desktop.ViewModels"
             xmlns:views="clr-namespace:Castorice.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="860"
             x:Class="Castorice.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer Padding="24,22" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">

      <StackPanel Spacing="2">
        <TextBlock Classes="display" Text="Settings" />
        <TextBlock Classes="muted" Text="Credentials, connection, lobby messages and appearance." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="osu! IRC" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding IrcPasswordHelp}" Margin="0,0,0,6" />

          <TextBlock Classes="label" Text="USERNAME" />
          <TextBox Text="{Binding Username}" PlaceholderText="osu! username" />

          <TextBlock Classes="label" Text="IRC PASSWORD" Margin="0,8,0,0" />
          <TextBox Text="{Binding IrcPassword}" PasswordChar="•" PlaceholderText="IRC server password" />

          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" Margin="0,0,14,0" Spacing="4">
              <TextBlock Classes="label" Text="SERVER" />
              <TextBox Text="{Binding IrcHost}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,14,0" Spacing="4">
              <TextBlock Classes="label" Text="PORT" />
              <NumericUpDown Value="{Binding IrcPort}" Minimum="1" Maximum="65535" Width="130"
                             FormatString="0" />
            </StackPanel>
            <CheckBox Grid.Column="2" Content="Use TLS" IsChecked="{Binding UseTls}" VerticalAlignment="Bottom" />
          </Grid>

          <TextBlock Classes="label" Text="AUTO-JOIN CHANNELS" Margin="0,12,0,0" />
          <TextBox Text="{Binding AutoJoinChannels}" PlaceholderText="#osu, #german" />

          <CheckBox Content="Connect automatically on start" IsChecked="{Binding AutoConnect}" Margin="0,10,0,0" />
          <CheckBox Content="This account is flagged as a bot (raises the send quota to 300/60s)"
                    IsChecked="{Binding HasBotAccount}" />
          <TextBlock Classes="faint" TextWrapping="Wrap"
                     Text="Leave the bot option off unless osu! staff granted the account bot status — exceeding the quota gets the account silenced. The change takes effect on the next start." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="osu! API" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ApiHelp}" Margin="0,0,0,6" />

          <TextBlock Classes="label" Text="CLIENT ID" />
          <TextBox Text="{Binding OsuClientId}" />

          <TextBlock Classes="label" Text="CLIENT SECRET" Margin="0,8,0,0" />
          <TextBox Text="{Binding OsuClientSecret}" PasswordChar="•" />

          <Button Content="Test credentials" Command="{Binding TestApiCommand}" Margin="0,12,0,0"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Mappool Builder" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="Import pools from the Mappool Builder on the Tournament page. Public pools need no token; for your own private pools, create a read token under API tokens on the site and paste it here." />

          <TextBlock Classes="label" Text="ADDRESS" />
          <TextBox Text="{Binding MappoolBuilderUrl}" PlaceholderText="https://pools.jansel.dev" />

          <TextBlock Classes="label" Text="API TOKEN (OPTIONAL)" Margin="0,8,0,0" />
          <TextBox Text="{Binding MappoolBuilderToken}" PasswordChar="•" PlaceholderText="tpz_…" />
          <TextBlock Classes="faint" TextWrapping="Wrap"
                     Text="A read token is enough — Castorice never changes pools. It is stored in the settings file next to the IRC password." />

          <Button Content="Test connection" Command="{Binding TestMappoolBuilderCommand}" Margin="0,12,0,0"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding Messages, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Lobby messages" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="What the tournament panel posts into the lobby by itself. Changes apply straight away; Post score and the draft's Post always send." />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
            <CheckBox Grid.Row="0" Grid.Column="0" Content="Map result" IsChecked="{Binding Messages.MapResult}"
                      ToolTip.Tip="NM1 | Red 1,234,567 - 1,000,000 Blue | Red wins by 234,567" />
            <CheckBox Grid.Row="0" Grid.Column="1" Content="FreeMod multipliers" IsChecked="{Binding Messages.Multipliers}"
                      ToolTip.Tip="Multipliers: player EZ x1.75 (500,000 -> 875,000)" />
            <CheckBox Grid.Row="1" Grid.Column="0" Content="Match score after each map" IsChecked="{Binding Messages.MatchScore}"
                      ToolTip.Tip="Match score: Red 3 - 2 Blue (first to 7), or who won the match" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="Match score after +1" IsChecked="{Binding Messages.ScoreOnManualPoint}"
                      ToolTip.Tip="Also post the score when a point is awarded by hand." />
            <CheckBox Grid.Row="2" Grid.Column="0" Content="Protects, bans and picks" IsChecked="{Binding Messages.DraftActions}"
                      ToolTip.Tip="Red bans NM2 · Blue picks DT1: Artist - Title [Diff]" />
            <CheckBox Grid.Row="2" Grid.Column="1" Content="Whose turn is next" IsChecked="{Binding Messages.NextTurn}"
                      ToolTip.Tip="Next: Blue bans (2/4) — after each protect or ban and after each scored map." />
            <CheckBox Grid.Row="3" Grid.Column="0" Content="FreeMod check warnings" IsChecked="{Binding Messages.FreeModWarnings}"
                      ToolTip.Tip="The automatic check's warning when someone's mods break the rule. The Check FreeMod button always posts." />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Application" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="THEME" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="170" />
          </StackPanel>

          <CheckBox Content="Ask before sending destructive commands (!mp close, kick)"
                    IsChecked="{Binding ConfirmDestructiveCommands}" />

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Classes="label" Text="VERSION" />
              <TextBlock Text="{Binding AppVersion}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="ghost" Content="Check for updates" Command="{Binding Updates.CheckNowCommand}"
                      IsEnabled="{Binding !Updates.IsChecking}" />
              <Button Classes="ghost" Content="About Castorice" Click="OnAboutClicked" />
            </StackPanel>
          </Grid>

          <CheckBox Content="Check for updates automatically" IsChecked="{Binding Updates.CheckForUpdates}"
                    ToolTip.Tip="Looks for a new release on GitHub when Castorice starts and every few hours, and offers it at the top of the window." />
          <TextBlock Classes="muted" Text="{Binding Updates.Status}" TextWrapping="Wrap"
                     IsVisible="{Binding Updates.Status, Converter={x:Static views:ViewConverters.IsNotEmpty}, FallbackValue=False}" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="CONFIG DIRECTORY" />
            <SelectableTextBlock Text="{Binding ConfigDirectory}" Classes="muted mono" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="MAPPOOL DIRECTORY" />
            <SelectableTextBlock Text="{Binding MappoolDirectory}" Classes="muted mono" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="IMAGE CACHE" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                <TextBlock Text="{Binding ImageCacheSummary}" FontWeight="SemiBold" />
                <SelectableTextBlock Text="{Binding ImageCacheDirectory}" Classes="muted mono" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Clear image cache" VerticalAlignment="Center"
                      Command="{Binding ClearImageCacheCommand}" />
            </Grid>
            <TextBlock Classes="faint" TextWrapping="Wrap"
                       Text="Covers and avatars are kept on disk, so a pool opens instantly and even offline. Clearing only means they download again the next time they are shown." />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="accent" Content="Save settings" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="well">
        <TextBlock Classes="faint" TextWrapping="Wrap"
                   Text="Credentials are stored in plain text in the config file above, which is created with owner-only permissions on macOS and Linux. Treat the file the way you would treat the password itself." />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
