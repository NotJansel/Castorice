<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore depends on whatever package sources the machine happens to have. NuGet merges every
    config from the drive root down to this folder, so a source list that is empty, or one where
    nuget.org has been switched off, makes every single package fail to resolve with NU1100 —
    including ones as ordinary as CommunityToolkit.Mvvm.

    The two <clear /> elements drop anything inherited from those outer files, so a checkout
    restores the same way on every machine.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- A parent config, or the IDE, may have disabled nuget.org by key; this re-enables it. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

</configuration>
